# Written automatically by `npm run deploy:local` in /blockchain. Copy to .env.local to edit by hand.
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Local
# Read-only RPC used to show data before a wallet connects (optional but recommended)
VITE_RPC_URL=http://127.0.0.1:8545
# Public block explorer. Leave empty on Hardhat: the dApp uses its built-in explorer page.
VITE_EXPLORER_URL=
# Block the contract was deployed in (speeds up event queries)
VITE_DEPLOY_BLOCK=0
